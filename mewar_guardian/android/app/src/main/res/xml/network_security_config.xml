<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust both Android system CA authorities and user-installed campus certificates -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Enforce HTTPS with system and user trust anchors for production backend -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">mewar-guardian.onrender.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
